# HTTP bind address (default: 127.0.0.1:4141)
M365_LISTEN=127.0.0.1:4141

# OAuth/account cache. Keep this file private and mode 0600.
M365_CONFIG=$HOME/.config/m365-native/accounts.json

# Optional one-time administrator bootstrap secret. There is no default.
# It is consumed on the first successful login and must be rotated immediately.
# Never commit a real value. Prefer M365_ADMIN_PASSWORD_BOOTSTRAP_FILE for deployments.
M365_ADMIN_PASSWORD=

# Writable persisted administrator credential path.
# M365_ADMIN_PASSWORD_FILE=$HOME/.config/m365-native/admin-password

# Optional read-only one-time bootstrap secret file.
# M365_ADMIN_PASSWORD_BOOTSTRAP_FILE=/run/secrets/m365_admin_password

# Remote management is disabled unless its exact public Host is allowlisted.
# Multiple entries may be separated by commas or whitespace.
# M365_ADMIN_ALLOWED_HOSTS=admin.example.com

# Forwarded headers are trusted only from explicitly listed loopback proxies.
# Do not enable this for ordinary direct localhost access.
# M365_ADMIN_TRUSTED_PROXIES=127.0.0.1/32
